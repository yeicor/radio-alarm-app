{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      // One PR for the whole AndroidX stack (including Compose).
      "groupName": "AndroidX",
      "matchPackageNames": ["/^androidx\\./"]
    },
    {
      // Kotlin compiler, Gradle plugin and the Compose compiler stay in lockstep.
      "groupName": "Kotlin",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin[.:]/"]
    },
    {
      "groupName": "Android Gradle plugin",
      "matchPackageNames": ["/^com\\.android\\.(tools\\.build|application)/"]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "groupName": "Gradle wrapper",
      "matchManagers": ["gradle-wrapper"]
    }
  ]
}
