<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_alarm" />

    <TextView
        android:id="@+id/widget_alarm_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/widget_no_alarm"
        android:textColor="#F6E9D8"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_minus"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/widget_action_earlier"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_minus" />

        <ImageView
            android:id="@+id/widget_middle"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/widget_action_skip"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_skip" />

        <ImageView
            android:id="@+id/widget_plus"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/widget_action_later"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_plus" />
    </LinearLayout>
</LinearLayout>
